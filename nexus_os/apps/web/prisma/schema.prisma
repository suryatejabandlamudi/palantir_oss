generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// --- INTEGRATION LAYER ---

model Integration {
  id          String   @id @default(uuid())
  systemId    String   @unique // "sap-erp-01", "salesforce-crm"
  type        String   // SAP, SALESFORCE, WORKDAY, SLACK, TEAMS, SERVICE_NOW
  name        String   // "Global SAP Instance"
  status      String   // ACTIVE, DISCONNECTED, ERROR
  config      String   // Encrypted JSON: { url, region, apiVersion }
  credentials String   // Encrypted JSON: { clientId, ... }
  
  resources   ExternalResource[]
  actions     IntegrationAction[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model IntegrationAction {
  id            String      @id @default(uuid())
  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id])
  
  name          String      // "Lock User", "Create PO"
  key           String      // "sap_lock_user"
  schema        String      // JSON Schema for inputs
  description   String
  
  protocolSteps ProtocolStep[]
}

// --- BUSINESS GRAPH (REAL DATA) ---

model ExternalResource {
  id            String      @id @default(uuid())
  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id])
  
  externalId    String      // "EMP-123456", "PO-998877"
  type          String      // EMPLOYEE, INVOICE, TICKET, CUSTOMER
  name          String      // "John Doe", "Acme Corp"
  metadata      String      // JSON: { email: "...", role: "..." }
  lastSyncedAt  DateTime    @default(now())
  
  // Relations could be added here for a true graph, e.g., @relation("ManagerSubordinate")
}

// --- PROTOCOL & WORKFLOW ENGINE ---

model Protocol {
  id            String   @id // "SEC-001"
  title         String
  description   String
  category      String   // ITSM, SecOps, Revenue, SupplyChain, HR
  status        String   // ACTIVE, DRAFT
  
  // The "Contract"
  contextSchema String   // JSON Schema of expected input
  triggerType   String   // EVENT, SCHEDULE, MANUAL
  triggerConfig String   // JSON: { event: "user.login", filter: "risk > 90" }
  
  steps         ProtocolStep[]
  runs          ProtocolRun[]
  
  // Legacy JSON fields for backward compatibility during migration if needed
  // stepsJson     String? 

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ProtocolStep {
  id             String   @id @default(uuid())
  protocolId     String
  protocol       Protocol @relation(fields: [protocolId], references: [id])
  
  order          Int
  description    String
  
  // What to do?
  actionId       String?
  action         IntegrationAction? @relation(fields: [actionId], references: [id])
  
  // Logic
  logicType      String   // LLM_DECISION, DETERMINISTIC_RULE
  logicConfig    String   // JSON: System prompt override, or Rule definition
}

// --- OBSERVABILITY & AUDIT ---

model ProtocolRun {
  id          String   @id @default(uuid())
  protocolId  String
  protocol    Protocol @relation(fields: [protocolId], references: [id])
  
  status      String   // RUNNING, COMPLETED, BLOCKED, FAILED
  startedAt   DateTime @default(now())
  completedAt DateTime?
  
  logs        RunLog[]
}

model RunLog {
  id            String       @id @default(uuid())
  runId         String
  run           ProtocolRun  @relation(fields: [runId], references: [id])
  
  timestamp     DateTime     @default(now())
  stepId        String?
  
  type          String       // THOUGHT, ACTION, SYSTEM
  severity      String       // INFO, WARN, ERROR
  message       String
  metadata      String       // JSON: { tokens: 150, latency: 200ms }
}

// --- AGENTS & PIPELINES (THE FORGE) ---

model Agent {
  id            String   @id @default(uuid())
  name          String
  role          String
  model         String   // "GEMINI_PRO_1_5", "GPT_4_O"
  temperature   Float    @default(0.7)
  systemPrompt  String
  
  // Knowledge Base
  documents     Document[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  // Relations
  nodes         PipelineNode[]
}

model AgentPipeline {
  id          String   @id @default(uuid())
  title       String
  description String
  active      Boolean  @default(false)
  
  nodes       PipelineNode[]
  edges       PipelineEdge[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PipelineNode {
  id          String   @id @default(uuid())
  pipelineId  String
  pipeline    AgentPipeline @relation(fields: [pipelineId], references: [id])
  
  type        String   // "AGENT", "TOOL", "TRIGGER"
  label       String
  
  // If type == AGENT
  agentId     String?
  agent       Agent?   @relation(fields: [agentId], references: [id])
  
  // If type == TOOL
  toolId      String?  // ID from MCP IntegrationAction
  
  // Visual Position (ReactFlow)
  positionX   Float
  positionY   Float
  
  // Config
  config      String   // JSON
}

model PipelineEdge {
  id          String   @id @default(uuid())
  pipelineId  String
  pipeline    AgentPipeline @relation(fields: [pipelineId], references: [id])
  
  source      String   // Node ID
  target      String   // Node ID
  label       String?
}

// --- RAG & KNOWLEDGE BASE ---

model Document {
  id          String   @id @default(uuid())
  title       String
  content     String   // Raw text content
  metadata    String   // JSON: { source: "sharepoint", author: "..." }
  
  chunks      DocumentChunk[]
  agents      Agent[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DocumentChunk {
  id          String   @id @default(uuid())
  documentId  String
  document    Document @relation(fields: [documentId], references: [id])
  
  content     String
  embedding   String   // Stored as JSON array or Base64 string for SQLite compatibility (Vector DB usually distinct)
  
  index       Int
}

// --- REAL-TIME SIMULATION LAYER (WARP, GOTHAM, MESH) ---

model Vehicle {
  id          String   @id @default(uuid())
  name        String
  model       String   // "Cybertruck", "Model Y"
  status      String   // "ACTIVE", "CHARGING", "IDLE", "MAINTENANCE"
  battery     Int
  lat         Float
  lng         Float
  location    String   // "Austin, TX"
  speed       Int      // mph
  heading     Int      // degrees
  
  updatedAt   DateTime @updatedAt
}

model Alert {
  id          String   @id @default(uuid())
  title       String
  severity    String   // "CRITICAL", "HIGH", "MEDIUM", "INFO"
  category    String   // "SECURITY", "FLEET", "IT"
  message     String
  status      String   // "ACTIVE", "RESOLVED"
  timestamp   DateTime @default(now())
  
  // Optional link to a protocol run if this alert triggered one
  runId       String?
}

model TerminalLog {
  id          String   @id @default(uuid())
  timestamp   DateTime @default(now())
  type        String   // "SYSTEM", "AGENT", "TOOL", "NETWORK"
  message     String
  source      String   // "Sentinel-1", "Orchestrator"
}
